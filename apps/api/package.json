{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:local": "PORT=3010 WEB_ORIGIN=http://localhost:5180 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint",
    "start": "node dist/server.js",
    "test": "vitest run",
    "auth:provision": "tsx src/scripts/provision-pilot.ts",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.10",
    "@supplier-price-control/contracts": "workspace:*",
    "@supplier-price-control/db": "workspace:*",
    "better-auth": "1.7.10",
    "nodemailer": "10.1.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.81.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
