HOST=127.0.0.1
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
# Development-only runtime role. Migration credentials belong in packages/db/.env.
DATABASE_URL=postgresql://spc_app:local_app_password@127.0.0.1:5433/supplier_price_control?schema=app
DATABASE_POOL_MAX=5
# Local-only secret. Production requires a private random value of at least 32 characters.
AUTH_SECRET=local-development-only-auth-secret-do-not-deploy
AUTH_SESSION_IDLE_SECONDS=604800
AUTH_SESSION_ABSOLUTE_SECONDS=2592000
# Start local mail capture: docker compose --profile mail up -d mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=login@example.test
# SMTP_USER and SMTP_PASSWORD are required together when your provider needs auth.
# Production SMTP requires TLS; configure credentials only in the environment.
# Keep zero for direct local API use. Configure the exact trusted proxy hop count at deployment.
TRUST_PROXY_HOPS=0
