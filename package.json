{
  "name": "supplier-price-control",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "devDependencies": { "@playwright/test": "1.64.1" },
  "scripts": {
    "dev": "pnpm db:build && pnpm --parallel --filter web --filter api dev",
    "dev:api": "pnpm db:build && pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm db:build && pnpm --filter web --filter api build",
    "build:api": "pnpm db:build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm --filter web --filter api --filter @supplier-price-control/db lint",
    "lint:api": "pnpm --filter api lint",
    "lint:web": "pnpm --filter web lint",
    "test": "pnpm --filter api test",
    "auth:provision": "pnpm db:build && pnpm --filter api auth:provision",
    "auth:test": "pnpm --filter api test:integration",
    "test:e2e": "playwright test",
    "typecheck": "pnpm db:build && pnpm --filter web --filter api --filter @supplier-price-control/db typecheck",
    "typecheck:api": "pnpm db:build && pnpm --filter api typecheck",
    "typecheck:web": "pnpm --filter web typecheck",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:build": "pnpm --filter @supplier-price-control/db build",
    "db:generate": "pnpm --filter @supplier-price-control/db generate",
    "db:validate": "pnpm --filter @supplier-price-control/db validate",
    "db:migrate": "pnpm --filter @supplier-price-control/db migrate:dev",
    "db:deploy": "pnpm --filter @supplier-price-control/db migrate:deploy",
    "db:status": "pnpm --filter @supplier-price-control/db migrate:status",
    "db:check": "pnpm --filter @supplier-price-control/db migrate:check",
    "db:test": "pnpm --filter @supplier-price-control/db test:integration"
  }
}
