generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

enum MembershipRole {
  owner
  editor
  viewer

  @@map("membership_role")
  @@schema("app")
}

model Organization {
  id          String                 @id @default(uuid()) @db.Uuid
  name        String                 @db.VarChar(200)
  timeZone    String?                @map("time_zone") @db.VarChar(100)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  auditEvents AuditEvent[]
  creations   OrganizationCreation[]
  suppliers   Supplier[]

  @@map("organizations")
  @@schema("app")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique @db.VarChar(254)
  displayName           String?                @map("display_name") @db.VarChar(200)
  emailVerified         Boolean                @default(false) @map("email_verified")
  image                 String?
  disabledAt            DateTime?              @map("disabled_at") @db.Timestamptz(3)
  activatedAt           DateTime?              @map("activated_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships           Membership[]
  sessions              Session[]
  accounts              Account[]
  organizationCreations OrganizationCreation[]

  @@map("users")
  @@schema("app")
}

model Membership {
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole @default(viewer)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditEvents    AuditEvent[]

  @@id([organizationId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("app")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(100)
  entityId       String?      @map("entity_id") @db.Uuid
  requestId      String?      @map("request_id") @db.VarChar(128)
  metadata       Json?        @db.JsonB
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor          Membership?  @relation(fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([organizationId, actorUserId])
  @@map("audit_events")
  @@schema("app")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("app")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @unique
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("verifications")
  @@schema("app")
}

model OrganizationCreation {
  userId         String       @map("user_id") @db.Uuid
  key            String       @db.VarChar(128)
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(200)
  timeZone       String?      @map("time_zone") @db.VarChar(100)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, key])
  @@index([organizationId])
  @@map("organization_creations")
  @@schema("app")
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(200)
  notes          String?      @db.VarChar(1000)
  archivedAt     DateTime?    @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, archivedAt, name, id])
  @@map("suppliers")
  @@schema("app")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("app")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
  @@schema("app")
}
